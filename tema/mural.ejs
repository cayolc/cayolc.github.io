<%
// Mural de capas (páginas de álbuns prediletos). A saída vai num bloco HTML cru
// (```{=html}) para o Quarto não tratá-la como Markdown. Os textos de cada idioma vêm de
// template-params, no cabeçalho de musica.qmd e en/music.qmd.
const t = templateParams || {};
const lang = t.lang || "pt-BR";
const sufixo = lang.startsWith("en") ? "en" : "pt";

const iso = (v) => (v instanceof Date ? v.toISOString().slice(0, 10) : String(v || ""));
const formataData = (v) => {
  const s = iso(v);
  const [a, m, d] = s.split("-").map(Number);
  if (!a) return "";
  if (!m) return String(a);
  const data = new Date(Date.UTC(a, m - 1, d || 1));
  const opcoes = d ? { day: "numeric", month: "long", year: "numeric" } : { month: "long", year: "numeric" };
  const texto = new Intl.DateTimeFormat(lang, { ...opcoes, timeZone: "UTC" }).format(data);
  // Em português, o primeiro dia do mês é "1º"
  return sufixo === "pt" && d === 1 ? texto.replace(/^1 /, "1º ") : texto;
};
const ident = (item) => "album-" + (item.artista + "-" + item.album).toLowerCase()
  .normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

// Grupos do filtro. Cada álbum cai num grupo deduzido do genero_pt, pela
// primeira regra que combinar; o campo "grupo" no musica.yml, se existir, manda.
const grupos = {
  metal: { pt: "Metal", en: "Metal", regra: /metal/i },
  hiphop: { pt: "Hip-hop", en: "Hip-hop", regra: /hip-hop|rap\b/i },
  rock: { pt: "Rock", en: "Rock", regra: /rock|punk/i },
  mpb: { pt: "MPB", en: "MPB", regra: /mpb|samba|bossa|ciranda|brega|forró|frevo|baião/i },
  pop: { pt: "Pop", en: "Pop", regra: /pop/i },
  eletronica: { pt: "Eletrônica", en: "Electronic", regra: /eletr|electr/i },
  folk: { pt: "Folk", en: "Folk", regra: /folk/i },
  experimental: { pt: "Experimental", en: "Experimental", regra: /experimental/i },
  outros: { pt: "Outros", en: "Other", regra: /.*/ },
};
const grupoDe = (item) => item.grupo && grupos[item.grupo] ? item.grupo
  : Object.keys(grupos).find((k) => grupos[k].regra.test(item.genero_pt || ""));

// Nome do artista no idioma da página (artista_en, se existir, na página em inglês)
const artistaDe = (item) => item["artista_" + sufixo] || item.artista;

const albuns = [...items].sort((x, y) => iso(y.lancamento).localeCompare(iso(x.lancamento)));
const contagem = {};
for (const item of albuns) { const g = grupoDe(item); contagem[g] = (contagem[g] || 0) + 1; }
// Grupos em ordem alfabética, com "Outros" sempre por último
const presentes = Object.keys(contagem).sort((x, y) =>
  (x === "outros") - (y === "outros") || grupos[x][sufixo].localeCompare(grupos[y][sufixo], lang));
%>
```{=html}
<div class="mural-filtro" role="group" aria-label="<%= t.filtrar %>">
  <button type="button" data-grupo="" aria-pressed="true"><%= t.todos %> <span class="mural-contagem"><%= albuns.length %></span></button>
<% for (const g of presentes) { %>  <button type="button" data-grupo="<%= g %>" aria-pressed="false"><%= grupos[g][sufixo] %> <span class="mural-contagem"><%= contagem[g] %></span></button>
<% } %></div>
<div class="mural">
<% for (const item of albuns) { const id = ident(item); %>
  <button type="button" class="mural-capa" aria-haspopup="dialog" aria-controls="<%= id %>"
          data-grupo="<%= grupoDe(item) %>"
          title="<%= item.album %>, <%= artistaDe(item) %>"
          onclick="document.getElementById('<%= id %>').showModal()">
    <img src="<%= item.capa %>" alt="<%= item.album %>, <%= artistaDe(item) %>" loading="lazy" width="600" height="600">
  </button>
<% } %>
</div>

<% for (const item of albuns) {
     const id = ident(item);
     const genero = item["genero_" + sufixo];
     const nota = item["nota_" + sufixo];
%>
<dialog id="<%= id %>" class="album" aria-labelledby="<%= id %>-titulo">
  <div class="album-corpo">
    <img class="album-capa" src="<%= item.capa %>" alt="" width="600" height="600">
    <div class="album-info">
      <p class="album-titulo" id="<%= id %>-titulo"><%= item.album %></p>
      <p class="album-artista"><%= artistaDe(item) %></p>
      <dl>
        <dt><%= t.lancamento %></dt><dd><%= formataData(item.lancamento) %></dd>
        <% if (genero) { %><dt><%= t.genero %></dt><dd><%= genero %></dd><% } %>
      </dl>
      <% if (nota) { %><p class="album-nota"><%= nota %></p><% } %>
      <p class="album-links">
        <% if (item.youtube_music) { %><a href="<%= item.youtube_music %>"><i class="bi bi-youtube" aria-hidden="true"></i> YouTube Music</a><% } %>
        <% if (item.apple_music) { %><a href="<%= item.apple_music %>"><i class="bi bi-apple" aria-hidden="true"></i> Apple Music</a><% } %>
      </p>
    </div>
  </div>
  <form method="dialog">
    <button class="album-fechar" aria-label="<%= t.fechar %>" title="<%= t.fechar %>">&times;</button>
  </form>
</dialog>
<% } %>

<script>
// Filtro: ao escolher um grupo, mostra só as capas dele
document.querySelectorAll(".mural-filtro button").forEach(function (botao, _, todos) {
  botao.addEventListener("click", function () {
    var g = botao.dataset.grupo;
    todos.forEach(function (b) { b.setAttribute("aria-pressed", String(b === botao)); });
    document.querySelectorAll(".mural-capa").forEach(function (c) {
      c.hidden = g !== "" && c.dataset.grupo !== g;
    });
  });
});

// Fecha a janela do álbum ao clicar fora dela
document.querySelectorAll("dialog.album").forEach(function (d) {
  d.addEventListener("click", function (e) { if (e.target === d) d.close(); });
});
</script>
```
