<%
// Mural de capas (páginas de álbuns prediletos). A saída vai num bloco HTML cru
// (```{=html}) para o Quarto não tratá-la como Markdown. Os textos de cada idioma vêm de
// template-params, no cabeçalho de musica.qmd e en/music.qmd.
const t = templateParams || {};
const lang = t.lang || "pt-BR";
const sufixo = lang.startsWith("en") ? "en" : "pt";

const iso = (v) => (v instanceof Date ? v.toISOString().slice(0, 10) : String(v || ""));
const formataData = (v) => {
  const s = iso(v);
  const [a, m, d] = s.split("-").map(Number);
  if (!a) return "";
  if (!m) return String(a);
  const data = new Date(Date.UTC(a, m - 1, d || 1));
  const opcoes = d ? { day: "numeric", month: "long", year: "numeric" } : { month: "long", year: "numeric" };
  const texto = new Intl.DateTimeFormat(lang, { ...opcoes, timeZone: "UTC" }).format(data);
  // Em português, o primeiro dia do mês é "1º"
  return sufixo === "pt" && d === 1 ? texto.replace(/^1 /, "1º ") : texto;
};
const ident = (item) => "album-" + (item.artista + "-" + item.album).toLowerCase()
  .normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

const albuns = [...items].sort((x, y) => iso(y.lancamento).localeCompare(iso(x.lancamento)));
%>
```{=html}
<div class="mural">
<% for (const item of albuns) { const id = ident(item); %>
  <button type="button" class="mural-capa" aria-haspopup="dialog" aria-controls="<%= id %>"
          title="<%= item.album %>, <%= item.artista %>"
          onclick="document.getElementById('<%= id %>').showModal()">
    <img src="<%= item.capa %>" alt="<%= item.album %>, <%= item.artista %>" loading="lazy" width="600" height="600">
  </button>
<% } %>
</div>

<% for (const item of albuns) {
     const id = ident(item);
     const genero = item["genero_" + sufixo];
     const nota = item["nota_" + sufixo];
%>
<dialog id="<%= id %>" class="album" aria-labelledby="<%= id %>-titulo">
  <div class="album-corpo">
    <img class="album-capa" src="<%= item.capa %>" alt="" width="600" height="600">
    <div class="album-info">
      <p class="album-titulo" id="<%= id %>-titulo"><%= item.album %></p>
      <p class="album-artista"><%= item.artista %></p>
      <dl>
        <dt><%= t.lancamento %></dt><dd><%= formataData(item.lancamento) %></dd>
        <% if (genero) { %><dt><%= t.genero %></dt><dd><%= genero %></dd><% } %>
      </dl>
      <% if (nota) { %><p class="album-nota"><%= nota %></p><% } %>
      <p class="album-links">
        <% if (item.youtube_music) { %><a href="<%= item.youtube_music %>"><i class="bi bi-youtube" aria-hidden="true"></i> YouTube Music</a><% } %>
        <% if (item.apple_music) { %><a href="<%= item.apple_music %>"><i class="bi bi-apple" aria-hidden="true"></i> Apple Music</a><% } %>
      </p>
    </div>
  </div>
  <form method="dialog">
    <button class="album-fechar" aria-label="<%= t.fechar %>" title="<%= t.fechar %>">&times;</button>
  </form>
</dialog>
<% } %>

<script>
// Fecha a janela do álbum ao clicar fora dela
document.querySelectorAll("dialog.album").forEach(function (d) {
  d.addEventListener("click", function (e) { if (e.target === d) d.close(); });
});
</script>
```
